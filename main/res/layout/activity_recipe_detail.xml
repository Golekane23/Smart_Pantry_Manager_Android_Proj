<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:id="@+id/txtDetailName" android:textSize="25sp" android:textStyle="bold"
   android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="Required ingredients" android:textStyle="bold" android:textSize="18sp"
   android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/txtDetailIngredients" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:text="Preparation method" android:textStyle="bold" android:textSize="18sp"
   android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/txtDetailSteps" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </LinearLayout>
</ScrollView>