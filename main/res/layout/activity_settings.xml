<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent">
 <TextView android:text="Settings" android:textSize="25sp" android:textStyle="bold"
  android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <CheckBox android:id="@+id/chkExpiry" android:text="Enable expiring-soon reminder preference"
  android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:text="This preference is saved locally on this device." android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>