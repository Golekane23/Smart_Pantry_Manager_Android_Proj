<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:id="@+id/txtFormTitle" android:text="Add ingredient" android:textSize="24sp" android:textStyle="bold"
   android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/edtName" android:hint="Ingredient name" android:inputType="textCapSentences"
   android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/edtQuantity" android:hint="Quantity (e.g. 2)" android:inputType="numberDecimal"
   android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/edtUnit" android:hint="Unit (e.g. pieces, g, ml)" android:inputType="text"
   android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <EditText android:id="@+id/edtExpiry" android:hint="Expiry date (optional: YYYY-MM-DD)" android:inputType="date"
   android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <Button android:id="@+id/btnSave" android:text="Save ingredient" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </LinearLayout>
</ScrollView>