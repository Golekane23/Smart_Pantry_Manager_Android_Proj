 android:layout_width="match_parent" android:layout_height="wrap_content">
 <TextView android:id="@+id/txtRecipeName" android:textSize="18sp" android:textStyle="bold"
  android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/txtRecipeIngredients" android:textSize="13sp"
  android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>